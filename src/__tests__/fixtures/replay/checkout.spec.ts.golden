// Generated by Orbit from replay script v3 of "Checkout with a coupon".
// Credentials are read from environment variables; Orbit never exports their values.
import { test, expect } from "@playwright/test";

const START_URL = process.env.ORBIT_START_URL ?? "https://staging.example.com/";

test.use({ storageState: process.env.ORBIT_STORAGE_STATE });

test("Checkout with a coupon", async ({ page }) => {
  await page.goto(START_URL);
  // Step 1: Log in (expected: Signed in)
  // Login step: the session from ORBIT_STORAGE_STATE is already signed in.
  // Step 2: Open the cart (expected: Cart page is shown)
  await page.goto(new URL("/cart?ref=email", START_URL).toString());
  await expect(page).toHaveURL(new RegExp("/cart"));
  // Step 3: Enter the coupon code (expected: Coupon field is filled)
  await page.getByRole("textbox", { name: "Coupon code", exact: true }).fill(process.env.COUPON_CODE ?? "");
  await expect(page.getByText("Coupon code").first()).toBeVisible();
  // Step 4: Enter the card holder (expected: Name is filled)
  await page.getByTestId("card-holder").fill(`Ada ${process.env.TEST_LAST_NAME ?? ""}`);
  await expect(page.locator("input[name=\"holder\"]").first()).toBeAttached();
  // Step 5: Choose express shipping (expected: Express is selected)
  await page.locator("#shipping").selectOption("express");
  await expect(page.locator("#shipping").first()).toHaveAttribute("data-value", "express");
  // Step 6: Press Enter to apply (expected: Coupon applied)
  await page.keyboard.press("Enter");
  await expect(page.locator("body")).toContainText("Coupon \"SPRING\" applied");
  // Step 7: Hover the total (expected: Breakdown tooltip appears)
  await page.getByText("Total", { exact: true }).hover();
  await expect(page.getByText("Subtotal").first()).toBeVisible();
  // Step 8: Scroll to the summary (expected: Summary visible)
  await page.mouse.wheel(0, 300);
  await expect(page.locator("#summary").first()).toBeVisible(); // Orbit also checks this element's accessibility
  // Step 9: Place the order (expected: Order confirmation page)
  await page.getByRole("button", { name: "Place order", exact: true }).click();
  await expect(page).toHaveURL(new RegExp("/orders/"));
  // Step 10: Check the order count (expected: One order listed)
  await expect(page.locator("li.order")).toHaveCount(1);
  // Step 11: Check the receipt link (expected: Receipt points at the PDF)
  await expect(page.locator("a.receipt").first()).toHaveAttribute("href", "/r/1.pdf");
});
