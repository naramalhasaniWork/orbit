# ============================================
# ORBIT — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgres://user:pass@host:port/dbname

# --- Redis ---
REDIS_URL=redis://default:pass@host:port

# --- Authentication + repo access: ONE GitHub App does both ---
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET are the GitHub App's OAuth credentials (App settings >
# "Client ID" / "Client secrets"). A plain OAuth App is not supported: linking installations
# needs a GitHub App user-to-server token. In the App settings:
#   - Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
#   - Setup URL: <NEXTAUTH_URL>/api/github/installations/callback
#   - Enable "Request user authorization (OAuth) during installation"
#   - Disable "Expire user authorization tokens" or expect re-login when they expire
# Also set GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_APP_SLUG below.
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- AI Providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Browser Automation ---
PLAYWRIGHT_WS_ENDPOINT=ws://your-playwright-host:3000
# USE_STAGEHAND=true              # Optional: enable Stagehand AI actions
# BROWSERBASE_API_KEY=            # Optional: Browserbase cloud browsers
# BROWSERBASE_PROJECT_ID=         # Optional: Browserbase project ID

# --- Storage ---
STORAGE_PROVIDER=local            # Options: local, s3, r2
# STORAGE_PATH=./storage          # For local storage
# S3_BUCKET=orbit-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=                    # For Cloudflare R2
# S3_PUBLIC_URL=                  # Optional CDN URL

# --- Encryption ---
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# --- Webhooks ---
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# --- Integrations (Optional) ---
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_URL=

# --- Self-hosting (all optional) ---
# ORBIT_SELF_HOSTED=true               # No billing/tier limits; "/" redirects to /login; first user becomes owner + super admin
# ORBIT_SIGNUP=invite                  # open | invite | closed (default: open on cloud, invite when self-hosted)
# ORBIT_ALLOWED_EMAIL_DOMAINS=acme.com # Comma-separated; restricts every sign-in to these domains
# ORBIT_ALLOW_PRIVATE_TARGETS=true     # Let environments/MCP servers point at localhost/LAN (link-local stays blocked)
# SKIP_ENV_VALIDATION=true             # Skip the boot-time env check (scripts only)
# ORBIT_GITHUB_TOKEN_FALLBACK=true     # Self-hosted only: let GITHUB_TOKEN read private repos too (default: public repos only)
# ORBIT_TRUSTED_PROXY_HOPS=1           # Reverse proxies in front of Orbit (Railway = 1); sets which X-Forwarded-For entry is the client IP
