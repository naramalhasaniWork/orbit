# ============================================
# ORBIT — Environment Variables
# ============================================
# Local dev:   cp .env.example .env.local
# Docker:      cp .env.selfhost.example .env   (see README)
# Generate secrets:
#   NEXTAUTH_SECRET=$(openssl rand -base64 32)
#   ENCRYPTION_KEY=$(openssl rand -hex 32)

# --- Required: database (PostgreSQL with pgvector) and Redis ---
DATABASE_URL=postgres://user:pass@localhost:5432/orbit
REDIS_URL=redis://localhost:6379

# --- Required: authentication + repo access (ONE GitHub App does both) ---
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET are the GitHub App's OAuth credentials (App settings >
# "Client ID" / "Client secrets"). A plain OAuth App is not supported: linking installations
# needs a GitHub App user-to-server token. In the App settings:
#   - Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
#   - Setup URL: <NEXTAUTH_URL>/api/github/installations/callback
#   - Enable "Request user authorization (OAuth) during installation"
#   - Disable "Expire user authorization tokens" or expect re-login when they expire
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Public base URL used in billing redirects (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails granted super_admin on sign-in
SUPER_ADMIN_EMAILS=

# --- Required: secret encryption (integration tokens, API keys) ---
# 64 hex chars, or any passphrase (derived with scrypt). Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=

# --- Transactional email (optional) ---
# Invitation emails are sent through Resend when both are set. Without them,
# invites still work: admins copy the invite link from the Team page.
# RESEND_API_KEY=
# EMAIL_FROM=Orbit <invites@your-domain.com>   # Must be a sender verified in Resend

# --- AI providers (set at least one chat provider) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Platform-wide OpenRouter key; workspaces can also bring their own key in Settings
# OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, LM Studio, Ollama's /v1). Private addresses need
# ORBIT_ALLOW_PRIVATE_TARGETS=true.
# ORBIT_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# ORBIT_OPENAI_COMPATIBLE_API_KEY=
# No platform key at all: every workspace adds its own in Settings > Providers
# ORBIT_AI_KEYS=byok

# Model tiers (defaults: claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5).
# Workspaces can still pick a model per agent in Settings.
# ORBIT_MODEL_FAST=
# ORBIT_MODEL_BALANCED=
# ORBIT_MODEL_DEEP=
# The browser agent starts on the fast tier and escalates to the balanced tier when it
# struggles. Pin a single model instead:
# ORBIT_AGENT_MODEL=
# Per-workspace AI request pacing (requests per minute, burst size)
# ORBIT_AI_RPM=120
# ORBIT_AI_BURST=20

# Embeddings for semantic search: openai | voyage | ollama | none.
# Unset: openai when OPENAI_API_KEY is set, otherwise none (keyword search).
# Changing it clears stored vectors; the next sync re-embeds.
# ORBIT_EMBEDDINGS=none
# ORBIT_EMBEDDINGS_MODEL=           # Override the provider's default model
# VOYAGE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Browser automation ---
# Remote Playwright server (e.g. the browserless sidecar). Docker compose sets this for you.
PLAYWRIGHT_WS_ENDPOINT=ws://localhost:3001
# USE_STAGEHAND=true               # Enable Stagehand AI actions
# BROWSERBASE_API_KEY=             # Browserbase cloud browsers
# BROWSERBASE_PROJECT_ID=

# --- Artifact storage ---
STORAGE_PROVIDER=local             # local | s3 | r2 (r2 also needs S3_ENDPOINT)
# STORAGE_PATH=/data/storage       # local only; defaults to /data/storage then /tmp/orbit-storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=                     # S3-compatible stores such as Cloudflare R2 or MinIO

# --- Deployment mode (all optional) ---
# ORBIT_SELF_HOSTED=true               # No billing/tier limits; "/" and marketing pages redirect to /login (privacy/terms/security stay); first user becomes owner + super admin
# ORBIT_ROLE=all                     # all (default: web + in-process workers) | web (HTTP only) | worker (BullMQ only, dist/worker.mjs)
# ORBIT_SIGNUP=invite                  # open | invite | closed (default: open on cloud, invite when self-hosted)
# ORBIT_ALLOWED_EMAIL_DOMAINS=acme.com # Comma-separated; restricts every sign-in to these domains
# ORBIT_ALLOW_PRIVATE_TARGETS=true     # Let environments/MCP servers point at localhost/LAN (link-local stays blocked)
# ORBIT_TRUSTED_PROXY_HOPS=1           # Reverse proxies in front of Orbit (Railway = 1); picks the client IP from X-Forwarded-For
# ORBIT_SKIP_MIGRATIONS=true           # Container only: skip `prisma migrate deploy` on start
# SKIP_ENV_VALIDATION=true             # Skip the boot-time env check (scripts only)
# ORBIT_GITHUB_TOKEN_FALLBACK=true     # Self-hosted only: let GITHUB_TOKEN read private repos too (default: public repos only)

# --- GitHub App (organization repo access) ---
# Callback: <NEXTAUTH_URL>/api/github/installations/callback
# Required unless ORBIT_SELF_HOSTED=true:
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_TOKEN=                    # Self-hosted only: operator token for public repos (see ORBIT_GITHUB_TOKEN_FALLBACK)
# GITHUB_WEBHOOK_SECRET=

# --- GitLab ---
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# --- Integrations ---
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# Linear webhooks: no env var; each Linear connection gets its own URL with a token (Settings → Integrations).
# SLACK_WEBHOOK_URL=
# SLACK_SIGNING_SECRET=   # the Orbit Slack app's; commands then need `/orbit link` (docs/integrations/slack.md)
# Railway webhooks: no env var; each Railway connection gets its own X-Orbit-Token (Settings → Integrations).

# --- Billing (Stripe; hosted offering only) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_ANNUAL_PRICE_ID=
# STRIPE_TEAM_MONTHLY_PRICE_ID=
# STRIPE_TEAM_ANNUAL_PRICE_ID=
