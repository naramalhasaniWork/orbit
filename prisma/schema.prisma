// INTEGRATION CONFIGS — per-workspace integration settings
// ============================================================

/// Read and written only through src/server/data/integration-repo.ts.
model IntegrationConfig {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  provider          IntegrationProvider
  isEnabled         Boolean             @default(true) @map("is_enabled")
  status            IntegrationStatus   @default(connected)
  /// The provider-side account the credentials act for (e.g. the Linear team id).
  externalAccountId String?             @map("external_account_id")
  displayName       String?             @map("display_name")
  /// A SealedSecret ({encrypted, iv}). Never select it outside integration-repo.
  credentialsSealed Json?               @map("credentials_sealed")
  /// Provider settings (domain/config/integrations), including lastError/lastErrorAt.
  settings          Json                @default("{}")
  /// sha256 of the inbound token: the Linear webhook URL token, or a pending Slack link code.
  inboundTokenHash  String?             @map("inbound_token_hash")
  /// Deprecated: superseded by settings/credentialsSealed; dropped a release after the 20261025 backfill.
  config            Json                @default("{}")
  /// Deprecated: see `config`.
  credentials       Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider], name: "integration_config_unique")
  @@index([provider, externalAccountId])
  @@index([inboundTokenHash])
  @@map("integration_configs")
}

// ============================================================
// PREVIEW DEPLOYMENTS — test a PR's preview deployment (Railway, Cloudflare Pages)
// ============================================================

/// A workspace's credentials for one preview provider. Webhooks are hints only; the
/// provider API is always queried before a preview is trusted.
model PreviewConnection {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  /// "railway" | "cloudflare_pages"
  provider         String
  label            String   @default("default")
  /// { encryptedToken, iv } via the vault
  credentials      Json     @default("{}")
  /// Non-secret provider config, e.g. { accountId } for Cloudflare
  config           Json     @default("{}")
  /// sha256 hex of the X-Orbit-Token webhook header value; null means webhooks are rejected
  webhookTokenHash String?  @map("webhook_token_hash")
  /// "active" | "error"
  status           String   @default("active")
  lastError        String?  @map("last_error")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bindings  PreviewBinding[]

  @@unique([workspaceId, provider, label], name: "preview_connection_unique")
  @@map("preview_connections")
}

/// Which provider target (Railway project/service, Cloudflare Pages project) builds a project's PR previews.
model PreviewBinding {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @unique @map("project_id") @db.Uuid
  connectionId        String   @map("connection_id") @db.Uuid
  /// Railway: "<projectId>/<serviceId>". Cloudflare Pages: the Pages project name.
  targetRef           String   @map("target_ref")
  targetLabel         String?  @map("target_label")
  /// A preview URL's host must equal or end with one of these, e.g. "up.railway.app"
  allowedHostSuffixes String[] @map("allowed_host_suffixes")
  /// Prefix of the project Secrets holding Cloudflare Access service-token credentials
  /// (<prefix>_CLIENT_ID / <prefix>_CLIENT_SECRET); null when previews are public.
  accessSecretPrefix  String?  @map("access_secret_prefix")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection  PreviewConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  deployments PreviewDeployment[]

  @@index([connectionId])
  @@map("preview_bindings")
}

/// One PR head commit waiting for, or tested on, its preview deployment.
model PreviewDeployment {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  bindingId     String    @map("binding_id") @db.Uuid
  commitSha     String    @map("commit_sha")
  /// The provider's deployment id, once resolve() has found it
  externalId    String?   @map("external_id")
  branch        String?
  prNumber      Int?      @map("pr_number")
  url           String?
  /// "pending" | "ready" | "failed" | "gone"
  status        String    @default("pending")
  error         String?
  environmentId String?   @map("environment_id") @db.Uuid
  runId         String?   @map("run_id") @db.Uuid
  checkRunId    String?   @map("check_run_id")
  readyAt       DateTime? @map("ready_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  binding     PreviewBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  environment Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@unique([bindingId, commitSha], name: "preview_deployment_commit")
  @@index([projectId, commitSha])
  @@index([status, createdAt])
  @@map("preview_deployments")
}

