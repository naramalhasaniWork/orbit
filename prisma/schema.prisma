generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

// ============================================================
// ENUMS
// ============================================================

enum ProjectStatus {
  active
  archived
  paused
}

enum RunStatus {
  queued
  indexing
  planning
  executing
  reporting
  completed
  failed
  cancelled
}

enum RunMode {
  full
  smoke
  regression
  targeted
}

enum RunTrigger {
  push
  pr
  scheduled
  manual
  linear
  api
  deploy
}

enum JobFailureStatus {
  open
  retried
  discarded
}

enum TestVerdict {
  pass
  fail
  flaky
  skipped
  healed
  environment_error
}

/// How a test result was produced: the LLM agent, a compiled replay script, or a replay the agent finished after a divergence
enum ExecutionMode {
  agent
  replay
  replay_healed
}

enum TestScriptStatus {
  active
  suspect
  retired
}

enum TestType {
  journey
  api_contract
  auth
  form_validation
  edge_case
  regression
  visual_regression
  operational_flow
  prerequisite_chain
}

enum MemberRole {
  owner
  admin
  member
  viewer
  billing
}

enum WorkspaceTier {
  free
  starter
  professional
  enterprise
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum SystemMapNodeType {
  route
  component
  endpoint
  model
  auth_strategy
  middleware
}

enum EnvironmentType {
  staging
  preview
  qa
  production
}

enum HealthStatus {
  healthy
  degraded
  failing
}

enum CreditTransactionType {
  consumption
  purchase
  refund
  monthly_grant
  adjustment
  expiry
}

enum ArtifactType {
  screenshot
  video
  dom_snapshot
  network_log
  console_log
}

enum IntegrationProvider {
  github
  gitlab
  linear
  slack
  railway
}

enum IntegrationStatus {
  connected
  disconnected
  error
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
  ignored
}

enum BaselineType {
  screenshot
  api_response
  dom_structure
}

enum KnowledgeFileType {
  openapi
  markdown
  design_system
  business_rules
  test_credentials
  other
}

enum UserRole {
  user
  admin
  super_admin
}

// ============================================================
// WORKSPACES & AUTH
// ============================================================

model Workspace {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  slug            String        @unique
  tier            WorkspaceTier @default(free)
  creditBalance   Int           @default(100) @map("credit_balance")
  monthlyCredits  Int           @default(100) @map("monthly_credits")
  // creditBalance is always the sum of the three buckets (lib/billing/credit-buckets.ts)
  creditsCurrent    Int       @default(100) @map("credits_current")
  creditsRollover   Int       @default(0) @map("credits_rollover")
  creditsPurchased  Int       @default(0) @map("credits_purchased")
  creditsGranted    Int       @default(100) @map("credits_granted")
  rolloverExpiresAt DateTime? @map("rollover_expires_at")
  // Start of the current credit period; Free resets its allowance a month after this
  creditsPeriodStart DateTime @default(now()) @map("credits_period_start")
  // Highest seat count already credited this period; a seat increase is credited only above it
  creditsPeriodPaidSeats Int @default(0) @map("credits_period_paid_seats")
  // Seats on the Stripe subscription; the member limit on seat-based tiers
  seatCount       Int           @default(1) @map("seat_count")
  tokenBudgetMonthly Int?       @map("token_budget_monthly")
  settings        Json          @default("{}")

  // Stripe billing fields
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  billingEmail         String?   @map("billing_email")
  billingPeriodStart   DateTime? @map("billing_period_start")
  billingPeriodEnd     DateTime? @map("billing_period_end")

  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  members              WorkspaceMember[]
  projects             Project[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  creditTransactions   CreditTransaction[]
  integrationConfigs   IntegrationConfig[]
  previewConnections   PreviewConnection[]
  pluginInstallations  PluginInstallation[]
  domainKnowledgeFiles DomainKnowledgeFile[]
  webhookEndpoints     WebhookEndpoint[]
  invitations          WorkspaceInvitation[]
  usageRecords         WorkspaceUsage[]
  subscriptions        Subscription[]
  tokenUsages          TokenUsage[]
  invoices             Invoice[]
  agentConfigs         AgentConfig[]
  providerConfigs      ProviderConfig[]
  promptVersions       PromptVersion[]
  mcpConnections       McpConnection[]
  githubInstallations  GitHubInstallation[]
  bugReports           BugReport[]

  @@map("workspaces")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  name              String?
  image             String?
  role              UserRole  @default(user)
  emailVerified     DateTime? @map("email_verified")
  githubId          String?   @unique @map("github_id")
  githubAccessToken String?   @map("github_access_token")
  settings          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  memberships    WorkspaceMember[]
  accounts       Account[]
  sessions       Session[]
  testPlans      TestPlan[]              @relation("ApprovedBy")
  testRuns       TestRun[]               @relation("TriggeredBy")
  auditLogs      AuditLog[]
  apiKeys        ApiKey[]                @relation("ApiKeyCreatedBy")
  invitedUsers   WorkspaceInvitation[]   @relation("InvitedBy")
  promptVersions PromptVersion[]         @relation("PromptCreatedBy")
  conversations  Conversation[]
  bugReports     BugReport[]

  @@map("users")
}

model WorkspaceMember {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], name: "workspace_member_unique")
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String
  role        MemberRole       @default(member)
  token       String           @unique
  status      InvitationStatus @default(pending)
  invitedById String           @map("invited_by") @db.Uuid
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@map("workspace_invitations")
}

model WorkspaceUsage {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  month       String   // "2026-02" format
  runsUsed    Int      @default(0) @map("runs_used")
  creditsUsed Int      @default(0) @map("credits_used")
  membersCount Int     @default(0) @map("members_count")
  projectsCount Int    @default(0) @map("projects_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month], name: "workspace_usage_month")
  @@index([workspaceId])
  @@map("workspace_usage")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token], name: "verification_token_unique")
  @@map("verification_tokens")
}

model GitHubInstallation {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  installationId Int      @map("installation_id")
  accountLogin   String   @map("account_login")
  accountType    String   @map("account_type") // "Organization" or "User"
  avatarUrl      String?  @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, installationId], name: "workspace_installation_unique")
  @@index([workspaceId])
  @@map("github_installations")
}

// ============================================================
// PROJECTS & REPOS
// ============================================================

model Project {
  id                  String        @id @default(uuid()) @db.Uuid
  workspaceId         String        @map("workspace_id") @db.Uuid
  name                String
  slug                String
  repoUrl             String        @map("repo_url")
  repoProvider        String        @default("github") @map("repo_provider")
  repoOwner           String        @map("repo_owner")
  repoName            String        @map("repo_name")
  defaultBranch       String        @default("main") @map("default_branch")
  framework           String?
  status              ProjectStatus @default(active)
  healthStatus        HealthStatus  @default(healthy) @map("health_status")
  lastIndexedAt       DateTime?     @map("last_indexed_at")
  lastRunAt           DateTime?     @map("last_run_at")
  config              Json          @default("{}")
  settings            Json          @default("{}")
  onboardingCompleted Boolean       @default(false) @map("onboarding_completed")
  /// Last TestRun.sequenceNumber handed out; advanced by the test_runs insert trigger.
  runCounter          Int           @default(0) @map("run_counter")
  deletedAt           DateTime?     @map("deleted_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments      Environment[]
  systemMapNodes    SystemMapNode[]
  systemMapEdges    SystemMapEdge[]
  testPlans         TestPlan[]
  testCases         TestCase[]
  testRuns          TestRun[]
  secrets           Secret[]
  flakyTests        FlakyTest[]
  selectorMappings  SelectorMapping[]
  selectorHistory    SelectorHistory[]
  webhookDeliveries  WebhookDelivery[]
  webhookEvents      WebhookEvent[]
  runArtifacts       RunArtifact[]
  failurePatterns    FailurePattern[]
  baselineSnapshots  BaselineSnapshot[]
  scheduledRuns      ScheduledRun[]
  testScripts        TestScript[]
  auditResults       AuditResult[]
  conversations      Conversation[]
  previewBinding     PreviewBinding?
  previewDeployments PreviewDeployment[]
  webhookEndpoints   WebhookEndpoint[]
  notes              ProjectNote[]

  @@unique([workspaceId, slug], name: "project_slug_workspace")
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("projects")
}

// ============================================================
// SCHEDULED RUNS — cron-based test schedule definitions
// ============================================================

model ScheduledRun {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  name           String
  cronExpression String    @map("cron_expression")
  mode           RunMode   @default(smoke)
  environmentId  String?   @map("environment_id") @db.Uuid
  isEnabled      Boolean   @default(true) @map("is_enabled")
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([isEnabled, nextRunAt])
  @@index([projectId])
  @@map("scheduled_runs")
}

// ============================================================
// ENVIRONMENTS & SECRETS
// ============================================================

model Environment {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  name           String
  type           EnvironmentType @default(staging)
  url            String
  teardownHookUrl String?        @map("teardown_hook_url")
  isDefault      Boolean         @default(false) @map("is_default")
  defaultRunMode String          @default("full") @map("default_run_mode")
  source         String?
  sourceId       String?         @map("source_id")
  /// "public" or "cloudflare_access" (headers from CF_ACCESS_* secrets are sent to this origin)
  accessMode     String          @default("public") @map("access_mode")
  /// Set when a preview environment's PR closes or its deployment is gone; archived environments are never picked as a default.
  archivedAt     DateTime?       @map("archived_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testRuns TestRun[]
  secrets  Secret[]
  previewDeployments PreviewDeployment[]

  @@index([projectId])
  @@map("environments")
}

model Secret {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  environmentId String?  @map("environment_id") @db.Uuid
  key           String
  encryptedValue String  @map("encrypted_value")
  iv            String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([projectId, environmentId, key], name: "secret_unique_key")
  @@map("secrets")
}

// ============================================================
// SYSTEM MAP
// ============================================================

model SystemMapNode {
  id            String                         @id @default(uuid()) @db.Uuid
  projectId     String                         @map("project_id") @db.Uuid
  type          SystemMapNodeType
  name          String
  filePath      String                         @map("file_path")
  metadata      Json                           @default("{}")
  embedding     Unsupported("vector")?
  lastIndexedAt DateTime                       @default(now()) @map("last_indexed_at")
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @default(now()) @updatedAt @map("updated_at")

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoingEdges SystemMapEdge[] @relation("SourceNode")
  incomingEdges SystemMapEdge[] @relation("TargetNode")

  @@index([projectId])
  @@index([projectId, type])
  @@index([projectId, filePath])
  // Keyword search (lib/db/vector.ts). Declared here so `prisma migrate dev/diff` keeps it
  // instead of emitting DROP INDEX; the HNSW and FTS expression indexes are invisible to Prisma.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "system_map_nodes_name_trgm_idx")
  @@map("system_map_nodes")
}

model SystemMapEdge {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  sourceNodeId String   @map("source_node_id") @db.Uuid
  targetNodeId String   @map("target_node_id") @db.Uuid
  relationship String
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode SystemMapNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode SystemMapNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("system_map_edges")
}

// ============================================================
// TEST PLANS
// ============================================================

model TestPlan {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  version     Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  generatedBy String    @default("planner") @map("generated_by")
  summary     Json      @default("{}")
  approvedAt  DateTime? @map("approved_at")
  approvedById String?  @map("approved_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy User?      @relation("ApprovedBy", fields: [approvedById], references: [id])
  testCases  TestCase[]
  testRuns   TestRun[]

  @@index([projectId])
  @@index([projectId, isActive])
  @@map("test_plans")
}

model TestCase {
  id           String      @id @default(uuid()) @db.Uuid
  testPlanId   String      @map("test_plan_id") @db.Uuid
  projectId    String      @map("project_id") @db.Uuid
  name         String
  type         TestType
  journey      String?
  priorityScore Int        @default(50) @map("priority_score")
  criticality  Int         @default(50)
  risk         Int         @default(50)
  coverageGap  Int         @default(50) @map("coverage_gap")
  steps        Json
  rationale    String?
  edgeCases    Json        @default("[]") @map("edge_cases")
  requiredRole String?     @map("required_role")
  isEnabled    Boolean     @default(true) @map("is_enabled")
  isCritical   Boolean     @default(false) @map("is_critical")
  lastVerdict  TestVerdict? @map("last_verdict")
  lastRunAt    DateTime?   @map("last_run_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  testPlan    TestPlan          @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testResults TestResult[]
  flakyTests  FlakyTest[]
  versions    TestCaseVersion[]
  scripts     TestScript[]

  @@index([testPlanId])
  @@index([projectId])
  @@index([projectId, journey])
  @@index([projectId, isCritical])
  @@map("test_cases")
}

// ============================================================
// TEST RUNS & RESULTS
// ============================================================

model TestRun {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  environmentId  String?    @map("environment_id") @db.Uuid
  testPlanId     String?    @map("test_plan_id") @db.Uuid
  status         RunStatus  @default(queued)
  mode           RunMode    @default(full)
  trigger        RunTrigger @default(manual)
  triggeredById  String?    @map("triggered_by") @db.Uuid
  branch         String?
  commitSha      String?    @map("commit_sha")
  prNumber       Int?       @map("pr_number")
  /// Human run number per project (#412). Assigned by the test_runs insert trigger; never set from code.
  sequenceNumber Int        @default(0) @map("sequence_number")
  totalTests     Int        @default(0) @map("total_tests")
  passed         Int        @default(0)
  failed         Int        @default(0)
  flaky          Int        @default(0)
  skipped        Int        @default(0)
  creditsConsumed Int       @default(0) @map("credits_consumed")
  summary        String?
  startedAt      DateTime?  @map("started_at")
  completedAt    DateTime?  @map("completed_at")
  durationMs     Int?       @map("duration_ms")
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id])
  testPlan    TestPlan?    @relation(fields: [testPlanId], references: [id])
  triggeredBy User?        @relation("TriggeredBy", fields: [triggeredById], references: [id])
  results     TestResult[]
  artifacts   RunArtifact[]
  traces      AgentExecutionTrace[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([status])
  @@unique([projectId, sequenceNumber])
  @@map("test_runs")
}

model TestResult {
  id                 String      @id @default(uuid()) @db.Uuid
  testRunId          String      @map("test_run_id") @db.Uuid
  testCaseId         String      @map("test_case_id") @db.Uuid
  verdict            TestVerdict
  durationMs         Int?        @map("duration_ms")
  retryCount         Int         @default(0) @map("retry_count")
  steps              Json        @default("[]")
  failureExplanation String?     @map("failure_explanation")
  suggestedFix       String?     @map("suggested_fix")
  artifacts          Json        @default("{}")
  healedSelectors    Json        @default("[]") @map("healed_selectors")
  executionMode      ExecutionMode @default(agent) @map("execution_mode")
  modelCalls         Int         @default(0) @map("model_calls")
  modelCostUsd       Decimal     @default(0) @map("model_cost_usd") @db.Decimal(10, 6)
  divergedAtStep     Int?        @map("diverged_at_step")
  createdAt          DateTime    @default(now()) @map("created_at")

  testRun      TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase     TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  runArtifacts RunArtifact[]

  @@unique([testRunId, testCaseId])
  @@index([testRunId, verdict])
  @@index([testCaseId])
  @@index([executionMode, createdAt])
  @@map("test_results")
}

// ============================================================
// COMPILED REPLAY SCRIPTS
// ============================================================

/// A passing agent run compiled into deterministic actions, replayed with zero model calls
model TestScript {
  id                    String           @id @default(uuid()) @db.Uuid
  projectId             String           @map("project_id") @db.Uuid
  testCaseId            String           @map("test_case_id") @db.Uuid
  version               Int
  status                TestScriptStatus @default(active)
  /// sha256 of the steps the script was compiled from; a mismatch means the case changed
  stepsHash             String           @map("steps_hash")
  /// environmentId:ROLE:WIDTHxHEIGHT
  envKey                String           @map("env_key")
  actions               Json
  coveredRoutes         String[]         @default([]) @map("covered_routes")
  coveredNodeIds        String[]         @default([]) @map("covered_node_ids")
  sourceRunId           String?          @map("source_run_id") @db.Uuid
  sourceCommitSha       String?          @map("source_commit_sha")
  replayCount           Int              @default(0) @map("replay_count")
  divergenceCount       Int              @default(0) @map("divergence_count")
  lastVerifiedByAgentAt DateTime         @default(now()) @map("last_verified_by_agent_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, envKey, version])
  @@index([testCaseId, envKey, status])
  @@index([projectId, status])
  @@index([coveredNodeIds], type: Gin)
  @@map("test_scripts")
}

// ============================================================
// FLAKY TEST REGISTRY
// ============================================================

model FlakyTest {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  testCaseId    String   @map("test_case_id") @db.Uuid
  occurrences   Int      @default(1)
  passRate      Float?   @map("pass_rate")
