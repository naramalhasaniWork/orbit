  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_notes")
}

// ============================================================
// SYSTEM CONFIG — global feature flags and platform settings
// ============================================================

model SystemConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ============================================================
// PLATFORM METRICS — system-wide analytics snapshots
// ============================================================

model PlatformMetrics {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @db.Date
  totalWorkspaces Int      @default(0) @map("total_workspaces")
  totalUsers      Int      @default(0) @map("total_users")
  totalProjects   Int      @default(0) @map("total_projects")
  totalRuns       Int      @default(0) @map("total_runs")
  runsToday       Int      @default(0) @map("runs_today")
  creditsConsumed Int      @default(0) @map("credits_consumed")
  errorRate       Float    @default(0) @map("error_rate")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@index([date])
  @@map("platform_metrics")
}

// ============================================================
// AUDIT RESULTS — code quality audit findings
// ============================================================

model AuditResult {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  runId         String?  @map("run_id") @db.Uuid
  overallScore  Int      @map("overall_score")
  categories    Json     @default("{}")
  issues        Json     @default("[]")
  issueCount    Int      @default(0) @map("issue_count")
  criticalCount Int      @default(0) @map("critical_count")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, createdAt])
  @@map("audit_results")
}

// ============================================================
// PROVIDER CONFIGS — per-workspace AI provider API key storage
// ============================================================

model ProviderConfig {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  provider        String   // "anthropic", "openai", "openrouter", "custom"
  displayName     String?  @map("display_name")
  apiKeyEncrypted String?  @map("api_key_encrypted")
  baseUrl         String?  @map("base_url")
  isActive        Boolean  @default(true) @map("is_active")
  isDefault       Boolean  @default(false) @map("is_default")
  settings        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider], name: "provider_config_unique")
  @@index([workspaceId])
  @@map("provider_configs")
}

// ============================================================
// MODEL REGISTRY — cache of available models from all providers
// ============================================================

// Which embedding provider/model/dimension produced the stored vectors (single row).
// Changing ORBIT_EMBEDDINGS clears vectors and rebuilds the HNSW index for the new dimension.
model EmbeddingConfig {
  id         String   @id @default("default")
  provider   String
  model      String
  dimensions Int
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("embedding_config")
}

model ModelRegistry {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  modelId         String    @map("model_id")
  displayName     String    @map("display_name")
  contextWindow   Int       @map("context_window")
  inputCostPer1M  Float     @map("input_cost_per_1m")
  outputCostPer1M Float     @map("output_cost_per_1m")
  capabilities    Json?
  isActive        Boolean   @default(true) @map("is_active")
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([provider, modelId], name: "model_registry_unique")
  @@index([provider])
  @@map("model_registry")
}

// ============================================================
// GLOBAL MODEL POLICIES — super admin controls for model access
// ============================================================

model GlobalModelPolicy {
  id               String   @id @default(uuid()) @db.Uuid
  modelId          String   @map("model_id")
  provider         String
  isAllowed        Boolean  @default(true) @map("is_allowed")
  requiredTier     String?  @map("required_tier")
  maxTemperature   Float?   @map("max_temperature")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([modelId, provider], name: "model_policy_unique")
  @@map("global_model_policies")
}

// ============================================================
// PROMPT VERSIONS — versioned prompt history
// ============================================================

model PromptVersion {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String?     @map("workspace_id") @db.Uuid
  agentPhase  AgentPhase  @map("agent_phase")
  promptType  String      @map("prompt_type") // "operator", "user", "agent"
  content     String
  version     Int         @default(1)
  isActive    Boolean     @default(true) @map("is_active")
  createdById String?     @map("created_by_id") @db.Uuid
  changelog   String?
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("PromptCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, agentPhase])
  @@index([agentPhase, isActive])
  @@map("prompt_versions")
}

// ============================================================
// MCP CONNECTIONS — user-connected external MCP servers
// ============================================================

model McpConnection {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  name            String
  description     String?
  serverUrl       String    @map("server_url")
  transportType   String    @default("sse") @map("transport_type")
  apiKeyEncrypted String?   @map("api_key_encrypted")
  apiKeyIv        String?   @map("api_key_iv")
  headers         Json?
  isActive        Boolean   @default(true) @map("is_active")
  toolsDiscovered Json?     @map("tools_discovered")
  lastConnectedAt DateTime? @map("last_connected_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("mcp_connections")
}

// ============================================================
// CONVERSATIONS & MESSAGES — Orbit Agent chat interface
// ============================================================

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([projectId, userId])
  @@index([projectId, isActive])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           String       // "user" | "assistant" | "tool_call" | "tool_result"
  content        String
  toolName       String?      @map("tool_name")
  toolArgs       Json?        @map("tool_args")
  toolResult     Json?        @map("tool_result")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================
// DEAD-LETTER QUEUE — jobs that exhausted their BullMQ attempts
// ============================================================

model JobFailure {
  id           String           @id @default(uuid()) @db.Uuid
  queue        String
  jobId        String           @map("job_id")
  jobName      String           @map("job_name")
  data         Json
  error        String
  stack        String?
  attemptsMade Int              @map("attempts_made")
  runId        String?          @map("run_id") @db.Uuid
  projectId    String?          @map("project_id") @db.Uuid
  status       JobFailureStatus @default(open)
  createdAt    DateTime         @default(now()) @map("created_at")
  resolvedAt   DateTime?        @map("resolved_at")
  resolvedBy   String?          @map("resolved_by") @db.Uuid

  @@unique([queue, jobId])
  @@index([status, createdAt])
  @@map("job_failures")
}

// ============================================================
// BUG REPORTS (in-app "Report a bug", triaged at /admin/reports)
// ============================================================

enum BugReportStatus {
  open
  resolved
}

model BugReport {
  id            String          @id @default(uuid()) @db.Uuid
  // Null once the workspace is deleted; the report itself is kept.
  workspaceId   String?         @map("workspace_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  message       String
  context       Json            @default("{}")
  screenshotKey String?         @map("screenshot_key")
  status        BugReportStatus @default(open)
  resolvedAt    DateTime?       @map("resolved_at")
  resolvedBy    String?         @map("resolved_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("bug_reports")
}
