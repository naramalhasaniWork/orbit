# Orbit self-hosting (docker compose). Copy to .env and fill in the blanks:
#   cp .env.selfhost.example .env
# DATABASE_URL, REDIS_URL and PLAYWRIGHT_WS_ENDPOINT are wired up by docker-compose.yml.
# Full variable reference: .env.example

ORBIT_SELF_HOSTED=true

# Public URL users reach Orbit at. GitHub OAuth callback: <NEXTAUTH_URL>/api/auth/callback/github
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Generate:  openssl rand -hex 32   (losing this makes stored integration secrets unreadable)
ENCRYPTION_KEY=

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SUPER_ADMIN_EMAILS=

# AI providers (at least one; OPENAI_API_KEY is needed for embeddings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database and browser sidecar credentials used by docker-compose.yml
POSTGRES_PASSWORD=
BROWSER_TOKEN=
