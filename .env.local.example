# ============================================
# ORBIT — Local Development Environment
# ============================================
# This file has Railway connection strings pre-configured (passwords masked).
# Replace REDACTED with actual passwords, then rename to .env.local

# --- Database (Railway PostgreSQL + pgvector) ---
DATABASE_URL=postgres://postgres:REDACTED@interchange.proxy.rlwy.net:37461/railway

# --- Redis (Railway) ---
REDIS_URL=redis://default:REDACTED@switchyard.proxy.rlwy.net:14546

# --- Authentication (GitHub OAuth) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- AI Providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Browser Automation ---
PLAYWRIGHT_WS_ENDPOINT=
# USE_STAGEHAND=true
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# --- Encryption ---
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
