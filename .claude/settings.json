{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(node:*)",
      "Bash(tsx:*)",
      "Bash(tsc:*)",
      "Bash(prisma:*)",
      "Bash(playwright:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ]
  },
  "preferences": {
    "tmuxSplitPanes": true
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true,
    "context7":true,
    "claude-code-setup":true,
    "code-review":true,
    "agent-sdk-dev":true,
    "feature-dev":true
  }
}
