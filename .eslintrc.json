          {"name": "openai", "message": "Call AI providers through src/server/ai/gateway.ts."},
          {
            "name": "@/server/data/scope",
            "importNames": ["forSystem"],
            "message": "forSystem() is for src/server/jobs and src/server/engine; use ctx.db (forWorkspace) elsewhere."
          }
        ],
        "patterns": [
          {
            "group": ["@anthropic-ai/sdk/*", "openai/*"],
            "message": "Call AI providers through src/server/ai/gateway.ts."
          }
        ]
      }
    ]
